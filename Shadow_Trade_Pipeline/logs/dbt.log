[0m13:37:33.768681 [debug] [Thread-2 (]: On model.shadow_trade_pipeline.int_trade_sequences: /* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "shadow_trade_pipeline", "target_name": "dev", "node_id": "model.shadow_trade_pipeline.int_trade_sequences"} */

  create view "shadowtradedb"."silver"."int_trade_sequences__dbt_tmp"
    
    
  as (
    

/*
  Intermediate model: int_trade_sequences
  ────────────────────────────────────────
  Identifies grid sequences and computes pip intervals between levels.

  A sequence = group of tickets sharing:
    - Same symbol
    - Same trade_type (BUY or SELL)
    - Same stop_loss (SL stays constant throughout a sequence;
      only TP gets updated as new levels are added)

  Within each sequence, tickets are ordered by trade_level to determine
  the pip distance between consecutive entry prices (L1→L2, L2→L3 etc.)

  Outputs:
    - One row per ticket with its sequence_id and pip interval to the
      NEXT level in the same sequence
    - Latest sequence per symbol for the symbol overview mart
*/

with lifecycle as (

    select
        ticket,
        symbol,
        trade_type,
        lots,
        trade_level,
        pip_size,
        open_price,
        stop_loss,
        take_profit,
        open_time,
        close_time,
        is_cancelled,
        strategy_name
    from "shadowtradedb"."silver"."int_trade_lifecycle"
    where not is_cancelled
      and stop_loss is not null      -- sequences always have a defined SL

),

-- ── Assign sequence IDs ───────────────────────────────────────────────────────
-- Group tickets by symbol + trade_type + stop_loss.
-- SL is the stable identifier — it doesn't change within a sequence.
-- sequence_id is ordered by the earliest open_time within the group
-- so sequence 1 = earliest known sequence for that symbol/direction/SL.
sequenced as (

    select
        *,
        dense_rank() over (
            partition by symbol, trade_type, stop_loss
            order by open_time
        ) as level_rank_in_sequence,

        dense_rank() over (
            partition by symbol, trade_type
            order by stop_loss, open_time
        ) as sequence_id

    from lifecycle

),

-- ── Pip interval between consecutive levels ───────────────────────────────────
-- For each ticket, find the open_price of the NEXT level in the same sequence
-- and compute the pip distance between them.
with_intervals as (

    select
        s.*,

        -- Open price of the next level in this sequence (if exists)
        lead(open_price) over (
            partition by symbol, trade_type, stop_loss
            order by trade_level
        ) as next_level_open_price,

        -- Pip interval = price distance to next level / pip_size
        round(
            abs(
                open_price - lead(open_price) over (
                    partition by symbol, trade_type, stop_loss
                    order by trade_level
                )
            ) / pip_size,
            1
        ) as pip_interval_to_next

    from sequenced s

),

-- ── Latest sequence per symbol ────────────────────────────────────────────────
-- For the symbol overview mart, we only want pip intervals from the
-- most recent sequence (identified by the latest close_time in the group).
latest_sequence_per_symbol as (

    select distinct on (symbol, trade_type)
        symbol,
        trade_type,
        stop_loss           as latest_sequence_sl,
        max(close_time) over (
            partition by symbol, trade_type, stop_loss
        )                   as sequence_latest_close
    from lifecycle
    where stop_loss is not null
    order by symbol, trade_type, max(close_time) over (
        partition by symbol, trade_type, stop_loss
    ) desc

),

-- ── Average pip interval for the latest sequence per symbol ───────────────────
latest_pip_intervals as (

    select
        wi.symbol,
        wi.trade_type,
        round(avg(wi.pip_interval_to_next), 1) as avg_pip_interval,
        max(wi.trade_level)                     as max_level_in_latest_sequence
    from with_intervals wi
    inner join latest_sequence_per_symbol ls
        on  wi.symbol     = ls.symbol
        and wi.trade_type = ls.trade_type
        and wi.stop_loss  = ls.latest_sequence_sl
    where wi.pip_interval_to_next is not null
    group by wi.symbol, wi.trade_type

)

-- ── Final output ──────────────────────────────────────────────────────────────
select
    wi.ticket,
    wi.symbol,
    wi.trade_type,
    wi.trade_level,
    wi.sequence_id,
    wi.level_rank_in_sequence,
    wi.stop_loss            as sequence_sl,
    wi.open_price,
    wi.pip_size,
    wi.pip_interval_to_next,
    wi.next_level_open_price,
    wi.open_time,
    wi.close_time,
    lpi.avg_pip_interval    as latest_avg_pip_interval,
    wi.strategy_name
from with_intervals wi
left join latest_pip_intervals lpi
    on  wi.symbol     = lpi.symbol
    and wi.trade_type = lpi.trade_type
  );
[0m13:37:33.768681 [debug] [Thread-1 (]: On model.shadow_trade_pipeline.mart_strategy_performance: /* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "shadow_trade_pipeline", "target_name": "dev", "node_id": "model.shadow_trade_pipeline.mart_strategy_performance"} */

  
    

  create  table "shadowtradedb"."gold"."mart_strategy_performance__dbt_tmp"
  
  
    as
  
  (
    

/*
  Mart model: mart_strategy_performance
  ──────────────────────────────────────
  One row per trade with all analytics columns for Power BI.
  Primary table for dashboard Summary and Deep Dive views.

  v2 changes:
    - Added trade_level, level_bucket columns
    - Added pip_size, pip_value columns
    - Added planned_rr, actual_r
*/

with lifecycle as (

    select * from "shadowtradedb"."silver"."int_trade_lifecycle"

),

signal_groups as (

    select
        ticket,
        dense_rank() over (
            partition by strategy_name, symbol
            order by date_trunc('hour', open_time),
                     floor(extract(epoch from open_time) / 300)
        ) as signal_group_id
    from lifecycle
    where not is_cancelled

),

final as (

    select
        -- ── Identity ──────────────────────────────────────────────────────
        l.ticket,
        l.symbol,
        l.trade_type,
        l.lots,
        l.strategy_name,
        l.position_tier,
        l.trade_result,
        l.is_cancelled,

        -- ── Level ─────────────────────────────────────────────────────────
        l.trade_level,

        -- Level bucket for KPI A grouping
        case
            when l.trade_level = 1                    then 'L1'
            when l.trade_level between 2  and 4       then 'L2-L4'
            when l.trade_level between 5  and 10      then 'L5-L10'
            when l.trade_level between 11 and 15      then 'L11-L15'
            when l.trade_level between 16 and 20      then 'L16-L20'
            when l.trade_level between 21 and 25      then 'L21-L25'
            when l.trade_level between 26 and 30      then 'L26-L30'
            else                                           'L30+'
        end as level_bucket,

        -- Bucket sort order for correct Power BI ordering
        case
            when l.trade_level = 1                    then 1
            when l.trade_level between 2  and 4       then 2
            when l.trade_level between 5  and 10      then 3
            when l.trade_level between 11 and 15      then 4
            when l.trade_level between 16 and 20      then 5
            when l.trade_level between 21 and 25      then 6
            when l.trade_level between 26 and 30      then 7
            else                                           8
        end as level_bucket_sort,

        -- ── Pip metrics ───────────────────────────────────────────────────
        l.pip_size,

        -- Pip value per pip per standard lot (derived from actual P&L)
        -- Formula: profit / (price_distance / pip_size) / lots
        -- Only calculable when we have a valid close price and profit
        case
            when l.close_price is not null
             and l.profit_loss is not null
             and l.profit_loss != 0
             and abs(l.close_price - l.open_price) > 0
            then round(
                abs(l.profit_loss)
                / (abs(l.close_price - l.open_price) / l.pip_size)
                / l.lots,
                4
            )
            else null
        end as pip_value,

        -- ── Signal group ──────────────────────────────────────────────────
        coalesce(sg.signal_group_id, 0) as signal_group_id,

        -- ── Entry ─────────────────────────────────────────────────────────
        l.open_time,
        l.open_price,
        l.stop_loss,
        l.take_profit,

        -- ── Exit ─────────────────────────────────────────────────────────
        l.close_time,
        l.close_price,
        l.profit_loss,
        l.duration_minutes,
        round(l.duration_minutes / 60.0, 2)     as duration_hours,

        -- ── Risk metrics ──────────────────────────────────────────────────
        l.risk_points,
        l.reward_points,

        -- Planned R:R
        case
            when l.risk_points > 0
            then round(l.reward_points / nullif(l.risk_points, 0), 2)
            else null
        end as planned_rr,

        -- Actual R achieved
        case
            when l.risk_points > 0
            then round(
                (l.close_price - l.open_price)
                * case when l.trade_type = 'BUY' then 1 else -1 end
                / nullif(l.risk_points, 0),
                2
            )
            else null
        end as actual_r,

        -- ── Win/Loss flags ────────────────────────────────────────────────
        case when l.trade_result = 'WIN'       then 1 else 0 end as is_win,
        case when l.trade_result = 'LOSS'      then 1 else 0 end as is_loss,
        case when l.trade_result = 'BREAKEVEN' then 1 else 0 end as is_breakeven,

        -- ── Date parts ───────────────────────────────────────────────────
        l.open_time::date                       as open_date,
        l.close_time::date                      as close_date,
        extract(hour   from l.open_time)::int   as open_hour,
        extract(dow    from l.open_time)::int   as open_day_of_week,
        to_char(l.open_time, 'Dy')              as open_day_name,
        extract(week   from l.open_time)::int   as open_week,
        extract(month  from l.open_time)::int   as open_month,
        extract(year   from l.open_time)::int   as open_year,
        to_char(l.close_time, 'YYYY-MM')        as close_month_label,
        to_char(l.close_time, 'IYYY-IW')        as close_week_label,

        -- ── Cumulative P&L ────────────────────────────────────────────────
        round(
            sum(coalesce(l.profit_loss, 0)) over (
                partition by l.strategy_name
                order by l.close_time
                rows between unbounded preceding and current row
            ),
            2
        ) as cumulative_pnl_by_strategy,

        round(
            sum(coalesce(l.profit_loss, 0)) over (
                order by l.close_time
                rows between unbounded preceding and current row
            ),
            2
        ) as cumulative_pnl_total,

        -- ── Source tracking ───────────────────────────────────────────────
        l.open_source_file,
        l.close_source_file

    from lifecycle l
    left join signal_groups sg on l.ticket = sg.ticket

)

select * from final
order by close_time desc
  );
  
