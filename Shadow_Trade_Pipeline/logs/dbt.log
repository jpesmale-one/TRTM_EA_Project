 < w.max_level_in_sequence
                then 'LOSS'

            -- This IS the highest level in the sequence
            -- → result determined by actual profit_loss
            when w.profit_loss > 0  then 'WIN'
            when w.profit_loss < 0  then 'LOSS'
            when w.profit_loss = 0  then 'BREAKEVEN'

