    when round(w.lots::numeric, 2) = 2.80 then 28
    when round(w.lots::numeric, 2) = 2.90 then 29
    when round(w.lots::numeric, 2) = 3.00 then 30
    -- L31+: fallback formula (0.50 base, 0.10 increments from L5)
