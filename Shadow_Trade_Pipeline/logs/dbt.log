[0m09:29:01.845114 [debug] [Thread-2 (]: On model.shadow_trade_pipeline.mart_strategy_performance: /* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "shadow_trade_pipeline", "target_name": "dev", "node_id": "model.shadow_trade_pipeline.mart_strategy_performance"} */

  
    

  create  table "shadowtradedb"."gold"."mart_strategy_performance__dbt_tmp"
  
  
    as
  
  (
    

/*
  Mart model: mart_strategy_performance
  ──────────────────────────────────────
  One row per trade with all analytics columns needed for Power BI.
  This is the primary table your dashboard connects to.

  Includes:
    - Full trade lifecycle (entry, exit, duration)
    - Strategy and position tier
    - P&L and win/loss result
    - Risk metrics (R:R, risk points, reward points)
    - Cumulative P&L (running total per strategy, ordered by close time)
    - Trade date parts (for time-of-day and day-of-week analysis)
    - Scale-in group ID (links all tiers of the same signal together)
*/

with lifecycle as (

    select * from "shadowtradedb"."silver"."int_trade_lifecycle"

),

-- ── Scale-in group identification ────────────────────────────────────────────
-- Trades sharing the same strategy + symbol + open_time window (±5 min)
-- are part of the same signal. Groups them for basket-level analysis.
signal_groups as (

    select
        ticket,
        dense_rank() over (
            partition by strategy_name, symbol
            order by date_trunc('hour', open_time),
                     -- bucket into 5-min windows to group near-simultaneous entries
                     floor(extract(epoch from open_time) / 300)
        ) as signal_group_id

    from lifecycle
    where not is_cancelled

),

-- ── Final mart ───────────────────────────────────────────────────────────────
final as (

    select
        -- ── Identity ──────────────────────────────────────────────────────
        l.ticket,
        l.symbol,
        l.trade_type,
        l.lots,
        l.strategy_name,
        l.position_tier,
        l.trade_result,
        l.is_cancelled,

        -- ── Scale-in group ────────────────────────────────────────────────
        -- All tiers of the same signal share this ID.
        -- Use in Power BI to analyse basket-level P&L vs individual tiers.
        coalesce(sg.signal_group_id, 0) as signal_group_id,

        -- ── Entry ─────────────────────────────────────────────────────────
        l.open_time,
        l.open_price,
        l.stop_loss,
        l.take_profit,

        -- ── Exit ─────────────────────────────────────────────────────────
        l.close_time,
        l.close_price,
        l.profit_loss,
        l.duration_minutes,
        round(l.duration_minutes / 60.0, 2)  as duration_hours,

        -- ── Risk metrics ──────────────────────────────────────────────────
        l.risk_points,
        l.reward_points,
        l.planned_rr,

        -- Actual R achieved (how many R did we actually make/lose?)
        case
            when l.risk_points > 0
            then round(
                (l.close_price - l.open_price)
                * case when l.trade_type = 'BUY' then 1 else -1 end
                / nullif(l.risk_points, 0),
                2
            )
            else null
        end as actual_r,

        -- ── Win/Loss flags for aggregation ────────────────────────────────
        case when l.trade_result = 'WIN'       then 1 else 0 end as is_win,
        case when l.trade_result = 'LOSS'      then 1 else 0 end as is_loss,
        case when l.trade_result = 'BREAKEVEN' then 1 else 0 end as is_breakeven,

        -- ── Date parts (for Power BI time intelligence) ───────────────────
        l.open_time::date                       as open_date,
        l.close_time::date                      as close_date,
        extract(hour   from l.open_time)::int   as open_hour,
        extract(dow    from l.open_time)::int   as open_day_of_week,   -- 0=Sun, 6=Sat
        to_char(l.open_time, 'Dy')              as open_day_name,
        extract(week   from l.open_time)::int   as open_week,
        extract(month  from l.open_time)::int   as open_month,
        extract(year   from l.open_time)::int   as open_year,

        -- ── Cumulative P&L per strategy ───────────────────────────────────
        -- Running total ordered by close time, partitioned by strategy.
        -- Drives the equity curve visual in Power BI.
        round(
            sum(coalesce(l.profit_loss, 0)) over (
                partition by l.strategy_name
                order by l.close_time
                rows between unbounded preceding and current row
            ),
            2
        ) as cumulative_pnl_by_strategy,

        -- Cumulative P&L across all strategies combined
        round(
            sum(coalesce(l.profit_loss, 0)) over (
                order by l.close_time
                rows between unbounded preceding and current row
            ),
            2
        ) as cumulative_pnl_total,

        -- ── Source tracking ───────────────────────────────────────────────
        l.open_source_file,
        l.close_source_file

    from lifecycle l
    left join signal_groups sg on l.ticket = sg.ticket

)

select * from final
order by close_time desc
  );
  
