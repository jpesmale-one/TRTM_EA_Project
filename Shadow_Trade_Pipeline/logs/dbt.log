[0m09:29:01.687255 [debug] [Thread-3 (]: On model.shadow_trade_pipeline.int_trade_lifecycle: /* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "shadow_trade_pipeline", "target_name": "dev", "node_id": "model.shadow_trade_pipeline.int_trade_lifecycle"} */

  create view "shadowtradedb"."silver"."int_trade_lifecycle__dbt_tmp"
    
    
  as (
    

/*
  Intermediate model: int_trade_lifecycle
  ────────────────────────────────────────
  Reconstructs one complete row per trade ticket by joining:
    - OPEN event  → entry details, strategy, position tier
    - Last MODIFY → final SL/TP (handles pre-filled and multi-adjust cases)
    - CLOSE event → exit price, P&L, duration

  Only includes CLOSED trades (complete lifecycle).
  Open/pending trades are excluded — they belong in a separate model later.

  SL/TP resolution logic:
    1. If the OPEN row has SL/TP pre-filled → use those directly
    2. Otherwise use the LAST MODIFY row's SL/TP values
    This correctly handles both patterns seen in your data.
*/

with stg as (

    select * from "shadowtradedb"."silver"."stg_trade_logs"

),

-- ── OPEN events ─────────────────────────────────────────────────────────────
opens as (

    select
        ticket,
        symbol,
        trade_type,
        lots,
        open_price,
        stop_loss           as open_sl,        -- may be NULL (pre-modify pattern)
        take_profit         as open_tp,        -- may be NULL (pre-modify pattern)
        is_prefilled_sltp,
        strategy_name,
        position_tier,
        server_time         as open_time,
        source_file         as open_source_file
    from stg
    where event_type = 'OPEN'

),

-- ── Last MODIFY per ticket ───────────────────────────────────────────────────
-- Uses DISTINCT ON to keep only the most recent MODIFY row per ticket.
-- This captures the final SL/TP state before close.
last_modify as (

    select distinct on (ticket)
        ticket,
        stop_loss           as final_sl,
        take_profit         as final_tp,
        server_time         as last_modify_time
    from stg
    where event_type = 'MODIFY'
    order by ticket, server_time desc

),

-- ── CLOSE events ────────────────────────────────────────────────────────────
closes as (

    select
        ticket,
        close_price,
        profit_loss,
        is_cancelled,
        server_time         as close_time,
        source_file         as close_source_file
    from stg
    where event_type = 'CLOSE'

),

-- ── Join into one row per trade ─────────────────────────────────────────────
joined as (

    select
        -- ── Identity ──────────────────────────────────────────────────────
        o.ticket,
        o.symbol,
        o.trade_type,
        o.lots,
        o.strategy_name,
        o.position_tier,

        -- ── Entry ─────────────────────────────────────────────────────────
        o.open_time,
        o.open_price,

        -- ── Final SL/TP resolution ────────────────────────────────────────
        -- Pre-filled: use OPEN row values directly
        -- Standard:   use last MODIFY values
        case
            when o.is_prefilled_sltp then o.open_sl
            else m.final_sl
        end as stop_loss,

        case
            when o.is_prefilled_sltp then o.open_tp
            else m.final_tp
        end as take_profit,

        -- ── Exit ─────────────────────────────────────────────────────────
        c.close_time,
        c.close_price,
        c.profit_loss,
        c.is_cancelled,

        -- ── Derived trade metrics ─────────────────────────────────────────

        -- Trade duration in minutes
        extract(epoch from (c.close_time - o.open_time)) / 60.0
            as duration_minutes,

        -- Risk in price points (open → stop loss distance)
        case
            when o.trade_type = 'BUY'
            then o.open_price - coalesce(
                    case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                    o.open_price
                 )
            when o.trade_type = 'SELL'
            then coalesce(
                    case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                    o.open_price
                 ) - o.open_price
        end as risk_points,

        -- Reward in price points (open → take profit distance)
        case
            when o.trade_type = 'BUY'
            then coalesce(
                    case when o.is_prefilled_sltp then o.open_tp else m.final_tp end,
                    o.open_price
                 ) - o.open_price
            when o.trade_type = 'SELL'
            then o.open_price - coalesce(
                    case when o.is_prefilled_sltp then o.open_tp else m.final_tp end,
                    o.open_price
                 )
        end as reward_points,

        -- Planned R:R ratio
        case
            when (
                case
                    when o.trade_type = 'BUY'
                    then o.open_price - coalesce(
                            case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                            o.open_price
                         )
                    when o.trade_type = 'SELL'
                    then coalesce(
                            case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                            o.open_price
                         ) - o.open_price
                end
            ) > 0
            then round(
                (
                    case
                        when o.trade_type = 'BUY'
                        then coalesce(
                                case when o.is_prefilled_sltp then o.open_tp else m.final_tp end,
                                o.open_price
                             ) - o.open_price
                        when o.trade_type = 'SELL'
                        then o.open_price - coalesce(
                                case when o.is_prefilled_sltp then o.open_tp else m.final_tp end,
                                o.open_price
                             )
                    end
                ) /
                nullif(
                    case
                        when o.trade_type = 'BUY'
                        then o.open_price - coalesce(
                                case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                                o.open_price
                             )
                        when o.trade_type = 'SELL'
                        then coalesce(
                                case when o.is_prefilled_sltp then o.open_sl else m.final_sl end,
                                o.open_price
                             ) - o.open_price
                    end,
                    0
                ),
                2
            )
            else null
        end as planned_rr,

        -- Win / Loss / Cancelled classification
        case
            when c.is_cancelled                then 'CANCELLED'
            when c.profit_loss > 0             then 'WIN'
            when c.profit_loss < 0             then 'LOSS'
            when c.profit_loss = 0             then 'BREAKEVEN'
        end as trade_result,

        -- Source file tracking
        o.open_source_file,
        c.close_source_file

    from opens o
    inner join closes c on o.ticket = c.ticket
    left  join last_modify m on o.ticket = m.ticket

)

select * from joined
  );
